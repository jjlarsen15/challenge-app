# OwnerOS environment
# Copy to `.env.local` for Next.js. Never commit real secrets.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# When true, the UI always uses the labeled demo workspace even if Supabase is configured.
NEXT_PUBLIC_FORCE_DEMO=false

# --- Supabase (required for Phase 3 auth, persistence, storage) ---
# Project URL, e.g. https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Prefer the current publishable key. The legacy anon JWT still works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used for admin/storage tasks. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (required for Phase 4 paid transcription, extraction, embeddings, answering) ---
# Leave empty to use mock adapters. Do not call paid APIs without this set.
OPENAI_API_KEY=

# Optional model overrides (server-side only)
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_EXTRACT_MODEL=gpt-4.1-mini
OPENAI_ANSWER_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Capture limits ---
MAX_AUDIO_UPLOAD_MB=25
MAX_DOCUMENT_UPLOAD_MB=10
